{
  "name": "graphql-federation",
  "packageManager": "yarn@4.9.2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "all": "concurrently --kill-others \"next dev --turbopack\" \"npm run gateway\"",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "gateway": "hive-gateway supergraph",
    "compose": "wgc router compose -i compose.yaml -o router.json"
  },
  "dependencies": {
    "@apollo/subgraph": "^2.11.2",
    "@graphql-hive/gateway": "^1.15.3",
    "@graphql-mesh/compose-cli": "^1.4.11",
    "@pothos/core": "^4.7.0",
    "@pothos/plugin-directives": "^4.2.3",
    "@pothos/plugin-federation": "^4.4.2",
    "concurrently": "^9.2.0",
    "graphql": "^16.11.0",
    "graphql-yoga": "^5.13.5",
    "next": "15.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "wgc": "^0.87.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
